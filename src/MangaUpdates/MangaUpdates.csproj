<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0;net48</TargetFrameworks>
		<AssemblyName>MangaUpdates</AssemblyName>
		<PackageId>MangaUpdates</PackageId>
		<OutputType>Library</OutputType>
		<Authors>FiliArrochada</Authors>
		<Company>MangaUpdates.NET</Company>
		<AssemblyTitle>MangaUpdates API client</AssemblyTitle>
		<Description>A type-safe C# client for the MangaUpdates API, built on Refit.</Description>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RootNamespace>MangaUpdates</RootNamespace>
		<!-- Source of truth for the package version; bump it for each release.
         Track the API's info.version in the first three components; bump the
         4th (revision) component for client-only fixes against the same API version. -->
		<Version>1.0.0.1</Version>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageProjectUrl>https://github.com/FiliArrochada/MangaUpdates.NET</PackageProjectUrl>
		<RepositoryUrl>https://github.com/FiliArrochada/MangaUpdates.NET.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReleaseNotes>Refit 15; multi-targets net10.0 and net48. Same MangaUpdates API surface (1.0.0).</PackageReleaseNotes>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Nullable>annotations</Nullable>
		<LangVersion>latest</LangVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- Versions are managed centrally in Directory.Packages.props (CPM). -->
		<PackageReference Include="Refit" />
		<PackageReference Include="Refit.HttpClientFactory" />
		<!-- Since Refit 14 the reflection request builder is a separate package; referenced here
		     so AddRefitClient and consumers' RestService.For<T> keep working. Version-locked to Refit. -->
		<PackageReference Include="Refit.Reflection" />
		<PackageReference Include="Polly" />
		<PackageReference Include="System.Text.Json" />
		<PackageReference Include="System.ComponentModel.Annotations" />
	</ItemGroup>

	<ItemGroup>
		<!-- Lets the test project exercise the internal handlers (BearerTokenHandler, RetryHandler). -->
		<InternalsVisibleTo Include="MangaUpdates.Test" />
	</ItemGroup>

	<ItemGroup>
		<!-- Ship the repo README as the package readme (referenced by PackageReadmeFile above).
         Path is relative to this project (repo root is two levels up). -->
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
