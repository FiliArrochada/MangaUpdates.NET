<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>MangaUpdates.Test</AssemblyName>
    <RootNamespace>MangaUpdates.Test</RootNamespace>
    <TargetFrameworks>net10.0;net48</TargetFrameworks>
    <!-- xunit.v3 test projects are executables (in-process runner) -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <Nullable>annotations</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MangaUpdates\MangaUpdates.csproj" />
  </ItemGroup>
</Project>
